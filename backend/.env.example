APP_NAME=AegisX
APP_ENV=development
DATABASE_URL=postgresql+psycopg://aegisx_user:YOUR_PASSWORD@localhost:5432/aegisx_dev

# Optional external intelligence/AI integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Frontend access
CORS_ORIGINS=http://localhost:5173

# Live monitoring controls
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
MAX_AUTHORIZED_DOMAINS=20
MAX_HOSTS_PER_SCOPE=10
DEFAULT_PORTS=80,443,22,8080
DEFAULT_CHECKS=dns,tls,service

# Browser data refresh (seconds)
UI_REFRESH_SECONDS=5
